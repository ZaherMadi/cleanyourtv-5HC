<?xml version="1.0" encoding="utf-8"?>
<!-- Settings rows and choices: frosted glass at rest, a lit glass edge for the current choice, solid white when
     focused (text turns dark through pill_text). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="140"
    android:exitFadeDuration="140">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4DFFFFFF" android:endColor="#26FFFFFF" />
            <stroke android:width="1.5dp" android:color="#E6FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#21FFFFFF" android:endColor="#0DFFFFFF" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings: the current theme on the left, the choices in glass cards on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_bg"
    android:orientation="horizontal"
    android:paddingStart="56dp"
    android:paddingEnd="48dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Left: who we are and the theme in use. -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="#FFFFFFFF"
            android:fontFamily="sans-serif-medium"
            android:textSize="36sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_subtitle"
            android:textColor="#A6FFFFFF"
            android:lineSpacingExtra="3dp"
            android:textSize="15sp" />

        <TextView
            style="@style/SettingsSection"
            android:layout_marginTop="24dp"
            android:text="@string/current_theme" />

        <FrameLayout
            android:id="@+id/themeCard"
            android:layout_width="280dp"
            android:layout_height="158dp"
            android:layout_marginTop="10dp"
            android:elevation="10dp">

            <ImageView
                android:id="@+id/themePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/settings_preview_scrim" />

            <TextView
                android:id="@+id/themeCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="14dp"
                android:textColor="#FFFFFFFF"
                android:fontFamily="sans-serif-medium"
                android:textSize="20sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/homeStyleChoice"
            style="@style/SettingsRow"
            android:layout_width="280dp"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/change_theme_short" />

        <!-- Signature: the 5HC logo (no background), "Made by 5HC", the site. -->
        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="112dp"
                android:adjustViewBounds="true"
                android:src="@drawable/logo_5hc"
                android:contentDescription="5HC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/made_by"
                android:textColor="#D9FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/site_5hc"
                android:textColor="#80FFFFFF"
                android:letterSpacing="0.08"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/reorderChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/reorder"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Right: the choices, grouped in cards. -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="44dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="28dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="44dp"
            android:paddingBottom="44dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Accueil -->
            <TextView style="@style/SettingsSection" android:text="@string/section_home" />

            <LinearLayout style="@style/SettingsCard">

                <TextView style="@style/SettingsLabel" android:text="@string/columns_label" />

                <LinearLayout style="@style/SettingsChoices">
                    <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
                    <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
                    <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
                    <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
                </LinearLayout>

                <TextView style="@style/SettingsLabel" android:layout_marginTop="20dp" android:text="@string/rows_below_dock_label" />

                <LinearLayout style="@style/SettingsChoices">
                    <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
                    <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
                    <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
                    <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
                </LinearLayout>

                <TextView style="@style/SettingsLabel" android:layout_marginTop="20dp" android:text="@string/dock_opacity_label" />

                <LinearLayout style="@style/SettingsChoices">
                    <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100 %" />
                    <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70 %" />
                    <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50 %" />
                    <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30 %" />
                </LinearLayout>
            </LinearLayout>

            <!-- Horloge et fond d'écran -->
            <TextView style="@style/SettingsSection" android:layout_marginTop="30dp" android:text="@string/section_clock" />

            <LinearLayout style="@style/SettingsCard">

                <TextView style="@style/SettingsLabel" android:text="@string/clock_label" />

                <LinearLayout style="@style/SettingsChoices">
                    <TextView android:id="@+id/clockSystem" style="@style/SettingsColumnChoice" android:text="@string/clock_format_system" />
                    <TextView android:id="@+id/clock12" style="@style/SettingsColumnChoice" android:text="@string/clock_format_12" />
                    <TextView android:id="@+id/clock24" style="@style/SettingsColumnChoice" android:text="@string/clock_format_24" />
                </LinearLayout>

                <TextView
                    android:id="@+id/wallpaperChoice"
                    style="@style/SettingsRow"
                    android:layout_marginTop="20dp"
                    android:drawableEnd="@drawable/ic_chevron_right_v2"
                    android:drawableTint="@drawable/pill_text" />
            </LinearLayout>

            <!-- Animations -->
            <TextView style="@style/SettingsSection" android:layout_marginTop="30dp" android:text="@string/section_motion" />

            <LinearLayout style="@style/SettingsCard">

                <TextView
                    android:id="@+id/animationsChoice"
                    style="@style/SettingsRow" />

                <TextView
                    android:id="@+id/advancedChoice"
                    style="@style/SettingsRow"
                    android:layout_marginTop="10dp" />

                <TextView
                    style="@style/SettingsHint"
                    android:text="@string/advanced_effects_warning" />
            </LinearLayout>

            <!-- Système -->
            <TextView style="@style/SettingsSection" android:layout_marginTop="30dp" android:text="@string/section_system" />

            <LinearLayout style="@style/SettingsCard">

                <TextView
                    android:id="@+id/openOnStartChoice"
                    style="@style/SettingsRow"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvSettingsChoice"
                    style="@style/SettingsRow"
                    android:text="@string/tv_settings"
                    android:drawableEnd="@drawable/ic_chevron_right_v2"
                    android:drawableTint="@drawable/pill_text" />

                <TextView
                    android:id="@+id/defaultHomeChoice"
                    style="@style/SettingsRow"
                    android:layout_marginTop="10dp"
                    android:text="@string/home_settings"
                    android:drawableEnd="@drawable/ic_chevron_right_v2"
                    android:drawableTint="@drawable/pill_text" />

                <TextView
                    style="@style/SettingsHint"
                    android:text="@string/home_settings_help" />

                <TextView
                    android:id="@+id/followThemeChoice"
                    style="@style/SettingsRow"
                    android:layout_marginTop="14dp"
                    android:text="@string/follow_theme" />

                <TextView
                    style="@style/SettingsHint"
                    android:text="@string/follow_theme_hint" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
